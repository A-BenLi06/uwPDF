<Page
    x:Class="LitePdfViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>

        <!-- HUD icon button (dark floating toolbar) -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="CheckedRect" RadiusY="7" Fill="#30FFFFFF" Opacity="0" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#3DFFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HUD text button style (for clickable zoom percentage) -->
        <Style x:Key="HudTextButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" RadiusX="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" RadiusX="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Color swatch in the HUD -->
        <Style x:Key="HudSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle
                                RadiusY="6"
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="1" />
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Thumbnail card button -->
        <Style x:Key="ThumbCardStyle" TargetType="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#0D000000" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#14000000" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent action button (empty state) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#0A7AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="BaseRect" RadiusY="7" Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#FFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#000000" Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BaseRect" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#EFEFF1">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar (Native AppBar controls & Segoe UI symbols) ===================== -->
        <Border Background="#F6F6F7" BorderBrush="#DADADF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left action area: Open, Save, Thumbnails toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                    <AppBarButton
                        x:Name="OpenButton"
                        Icon="OpenFile"
                        IsCompact="True"
                        AutomationProperties.Name="Open PDF"
                        ToolTipService.ToolTip="打开 PDF (Ctrl+O)"
                        Click="OpenButton_Click" />
                    <AppBarButton
                        x:Name="SaveButton"
                        Icon="Save"
                        IsCompact="True"
                        AutomationProperties.Name="Save"
                        ToolTipService.ToolTip="保存墨迹 (Ctrl+S)"
                        Click="SaveButton_Click" />
                    <AppBarSeparator />
                    <AppBarToggleButton
                        x:Name="ThumbsToggle"
                        IsCompact="True"
                        IsChecked="False"
                        AutomationProperties.Name="Page thumbnails"
                        ToolTipService.ToolTip="页面缩略图"
                        Click="ThumbsToggle_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </StackPanel>

                <!-- Center area: File Name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#8A8A90" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="FileNameText"
                        VerticalAlignment="Center"
                        MaxWidth="400"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#1D1D1F"
                        Text="Lite PDF Viewer"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right action area: Inking tools (Windows Snip & Sketch style in title bar) -->
                <StackPanel x:Name="InkControlsPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                    <AppBarSeparator />
                    <AppBarToggleButton
                        x:Name="TopTouchWritingButton"
                        IsCompact="True"
                        AutomationProperties.Name="Touch writing"
                        ToolTipService.ToolTip="触摸书写 (开/关)"
                        Click="TopTouchWritingButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xED5F;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>

                    <AppBarToggleButton
                        x:Name="TopPenButton"
                        IsCompact="True"
                        AutomationProperties.Name="Pen"
                        ToolTipService.ToolTip="圆珠笔 (点击选择，再次点击配置颜色与粗细)"
                        Click="TopPenButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xED63;" />
                        </AppBarToggleButton.Icon>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="PenFlyout" Placement="Bottom">
                                <StackPanel Width="236" Margin="4">
                                    <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                    <Grid x:Name="PenColorGrid" />
                                    <TextBlock Text="大小" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                    <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                        <Canvas Height="36">
                                            <Path
                                                x:Name="PenPreviewStroke"
                                                Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18"
                                                Stroke="#E81123"
                                                StrokeThickness="3"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Border>
                                    <Slider
                                        x:Name="PenSizeSlider"
                                        Minimum="1"
                                        Maximum="24"
                                        Value="3"
                                        StepFrequency="1"
                                        IsThumbToolTipEnabled="False"
                                        ValueChanged="PenSizeSlider_ValueChanged" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AppBarToggleButton>

                    <AppBarToggleButton
                        x:Name="TopHighlighterButton"
                        IsCompact="True"
                        AutomationProperties.Name="Highlighter"
                        ToolTipService.ToolTip="荧光笔 (点击选择，再次点击配置颜色与粗细)"
                        Click="TopHighlighterButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xED60;" />
                        </AppBarToggleButton.Icon>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="HighlighterFlyout" Placement="Bottom">
                                <StackPanel Width="236" Margin="4">
                                    <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                    <Grid x:Name="HighlighterColorGrid" />
                                    <TextBlock Text="大小" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                    <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                        <Canvas Height="36">
                                            <Path
                                                x:Name="HighlighterPreviewStroke"
                                                Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18"
                                                Stroke="#FFF100"
                                                StrokeThickness="12"
                                                Opacity="0.6"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Border>
                                    <Slider
                                        x:Name="HighlighterSizeSlider"
                                        Minimum="4"
                                        Maximum="36"
                                        Value="12"
                                        StepFrequency="1"
                                        IsThumbToolTipEnabled="False"
                                        ValueChanged="HighlighterSizeSlider_ValueChanged" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AppBarToggleButton>

                    <AppBarToggleButton
                        x:Name="TopEraserButton"
                        IsCompact="True"
                        AutomationProperties.Name="Eraser"
                        ToolTipService.ToolTip="橡皮擦"
                        Click="TopEraserButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xED61;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>

                    <AppBarSeparator />

                    <AppBarButton
                        x:Name="TopUndoButton"
                        Icon="Undo"
                        IsCompact="True"
                        AutomationProperties.Name="Undo"
                        ToolTipService.ToolTip="撤销"
                        Click="UndoButton_Click" />

                    <AppBarButton
                        x:Name="TopClearButton"
                        Icon="Delete"
                        IsCompact="True"
                        AutomationProperties.Name="Clear"
                        ToolTipService.ToolTip="清除本页墨迹"
                        Click="ClearButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1" SizeChanged="DocumentSurface_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ThumbnailPane"
                Width="0"
                HorizontalAlignment="Left"
                Visibility="Collapsed"
                Background="#F7F7F8"
                BorderBrush="#DFDFE3"
                BorderThickness="0,0,1,0">
                <Grid Width="150">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#86868B"
                        Text="Pages" />
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ThumbnailPanel" Margin="10,10,10,20" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="DocumentScroller"
                Grid.Column="1"
                AutomationProperties.Name="Document scroller"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Enabled"
                MinZoomFactor="0.25"
                MaxZoomFactor="4"
                Background="#EFEFF1"
                SizeChanged="DocumentScroller_SizeChanged"
                ViewChanged="DocumentScroller_ViewChanged"
                LayoutUpdated="DocumentScroller_LayoutUpdated">
                <Grid x:Name="PageFrame" HorizontalAlignment="Center">
                    <StackPanel x:Name="PageStack" HorizontalAlignment="Center" />
                </Grid>
            </ScrollViewer>

            <!-- ===================== Floating HUD toolbar (Quick Look style) ===================== -->
            <Border
                x:Name="HudBar"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                RequestedTheme="Dark"
                Visibility="Collapsed">
                <Grid>
                    <Rectangle
                        RadiusX="10"
                        RadiusY="10"
                        Fill="#F22B2B30"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1" />
                    <StackPanel Orientation="Horizontal" Margin="8,6" VerticalAlignment="Center">

                        <!-- page navigation -->
                        <Button
                            x:Name="PreviousButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="Previous page"
                            ToolTipService.ToolTip="上一页"
                            Click="PreviousButton_Click">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <TextBlock
                            x:Name="PageStatusText"
                            MinWidth="52"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Text="0 / 0"
                            TextAlignment="Center" />
                        <Button
                            x:Name="NextButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="Next page"
                            ToolTipService.ToolTip="下一页"
                            Click="NextButton_Click">
                            <SymbolIcon Symbol="Next" />
                        </Button>

                        <Rectangle Width="1" Height="18" RadiusX="0.5" RadiusY="0.5" Margin="7,0" Fill="#24FFFFFF" />

                        <!-- zoom controls -->
                        <Button
                            x:Name="ZoomOutButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="Zoom out"
                            ToolTipService.ToolTip="缩小 (-)"
                            Click="ZoomOutButton_Click">
                            <SymbolIcon Symbol="ZoomOut" />
                        </Button>

                        <Button
                            x:Name="ZoomPercentButton"
                            Style="{StaticResource HudTextButtonStyle}"
                            AutomationProperties.Name="Zoom ratio"
                            ToolTipService.ToolTip="点击输入精确缩放比例"
                            Click="ZoomPercentButton_Click">
                            <TextBlock
                                x:Name="ZoomLabel"
                                MinWidth="38"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#F2FFFFFF"
                                Text="100%"
                                TextAlignment="Center" />
                            <Button.Flyout>
                                <Flyout x:Name="ZoomInputFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal" Padding="4">
                                        <TextBox
                                            x:Name="ZoomInputBox"
                                            Width="56"
                                            Height="32"
                                            FontSize="13"
                                            TextAlignment="Right"
                                            VerticalContentAlignment="Center"
                                            KeyDown="ZoomInputBox_KeyDown" />
                                        <TextBlock
                                            Text="%"
                                            VerticalAlignment="Center"
                                            Margin="4,0,8,0"
                                            FontSize="13"
                                            Foreground="#333333" />
                                        <Button
                                            x:Name="ZoomInputOkButton"
                                            Content="确定"
                                            Height="32"
                                            MinWidth="46"
                                            Click="ZoomInputOkButton_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="ZoomInButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="Zoom in"
                            ToolTipService.ToolTip="放大 (+)"
                            Click="ZoomInButton_Click">
                            <SymbolIcon Symbol="ZoomIn" />
                        </Button>

                        <!-- Zoom Slider (Native UWP Slider) -->
                        <Slider
                            x:Name="ZoomSlider"
                            Width="84"
                            Margin="4,0"
                            Minimum="25"
                            Maximum="400"
                            Value="100"
                            StepFrequency="1"
                            IsThumbToolTipEnabled="False"
                            AutomationProperties.Name="Zoom slider"
                            ToolTipService.ToolTip="缩放滑块"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />

                        <Button
                            x:Name="FitButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="Fit page"
