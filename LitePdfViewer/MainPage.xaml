<Page
    x:Class="LitePdfViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <Style TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style TargetType="AppBarButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#252A32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="AppBarButton">
                        <Grid Background="Transparent">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                            <Border x:Name="Selected" Background="#DCEBFA" BorderBrush="#7CB1E1" BorderThickness="1" CornerRadius="6" Opacity="0" />
                            <Border x:Name="Hover" Background="#12000000" CornerRadius="6" Opacity="0" />
                            <Border x:Name="PressSurface" Background="#22000000" CornerRadius="6" Opacity="0" />
                            <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="FocusOutline" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="6" Margin="1" Opacity="0" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="PressSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusOutline" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="AppBarToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#252A32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="AppBarToggleButton">
                        <Grid Background="Transparent">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                            <Border x:Name="Selected" Background="#DCEBFA" BorderBrush="#7CB1E1" BorderThickness="1" CornerRadius="6" Opacity="0" />
                            <Border x:Name="Hover" Background="#12000000" CornerRadius="6" Opacity="0" />
                            <Border x:Name="PressSurface" Background="#22000000" CornerRadius="6" Opacity="0" />
                            <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="FocusOutline" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="6" Margin="1" Opacity="0" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Checked"><Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="CheckedPressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="PressSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="CheckedDisabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" /><DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="PressSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="IconContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusOutline" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>


        <!-- Native ScrollBar parts retain range, drag and page-click behavior.
             Every state uses a 3-DIP visual inside a 12-DIP input surface. -->
        <ControlTemplate x:Key="ThinScrollThumb" TargetType="primitives:Thumb">
            <Grid Background="Transparent" Width="12">
                <Border Width="3" HorizontalAlignment="Right" Margin="0,0,2,0"
                    CornerRadius="1.5" Background="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ScrollTrackButton" TargetType="primitives:RepeatButton">
            <Grid Background="Transparent" />
        </ControlTemplate>
        <Style TargetType="primitives:ScrollBar">
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Width" Value="12" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                    <VisualState x:Name="NoIndicator" />
                                    <VisualState x:Name="TouchIndicator" />
                                    <VisualState x:Name="MouseIndicator" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="VerticalRoot">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <primitives:RepeatButton x:Name="VerticalSmallDecrease" Height="0" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2" Width="12" MinHeight="24"
                                    Template="{StaticResource ThinScrollThumb}" AutomationProperties.AccessibilityView="Raw" />
                                <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HUD icon button (dark floating toolbar) -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="CheckedRect" RadiusY="7" Fill="#30FFFFFF" Opacity="0" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#3DFFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HUD text button style (for clickable zoom percentage) -->
        <Style x:Key="HudTextButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" RadiusX="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" RadiusX="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Color swatch in the HUD -->
        <Style x:Key="HudSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle
                                RadiusY="6"
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="1" />
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Thumbnail card button -->
        <Style x:Key="ThumbCardStyle" TargetType="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#0D000000" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#14000000" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent action button (empty state) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#0A7AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="BaseRect" RadiusY="7" Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#FFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#000000" Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BaseRect" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainChrome" Background="#EFEFF1">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar (Native AppBar controls & Segoe UI symbols) ===================== -->
        <Border Background="#F6F6F7" BorderBrush="#DADADF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left action area: Open, Save, Thumbnails toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                    <AppBarButton
                        x:Name="OpenButton" Width="40"

                        IsCompact="True"
                        AutomationProperties.Name="打开 PDF"
                        ToolTipService.ToolTip="打开 PDF (Ctrl+O)"
                        Click="OpenButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE1C1;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton
                        x:Name="SaveButton" Width="40"

                        IsCompact="True"
                        AutomationProperties.Name="保存批注"
                        ToolTipService.ToolTip="保存批注 (Ctrl+S)"
                        Click="SaveButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE105;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarSeparator />
                    <AppBarToggleButton
                        x:Name="ThumbsToggle" Width="40"
                        IsCompact="True"
                        IsChecked="False"
                        AutomationProperties.Name="页面缩略图"
                        ToolTipService.ToolTip="页面缩略图"
                        Click="ThumbsToggle_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE161;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </StackPanel>

                <!-- Center area: File Name -->
                <Grid x:Name="FileTitleRegion" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE160;" FontSize="13" Foreground="#8A8A90" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="FileNameText" Grid.Column="1"
                        VerticalAlignment="Center"
                        MaxWidth="400"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#1D1D1F"
                        Text="uwPDF"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Compact commands leave the natural PDF window readable. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <AppBarButton x:Name="ExportButton" Width="40" IsCompact="True" AutomationProperties.Name="导出批注 PDF"
                        ToolTipService.ToolTip="导出带批注的 PDF 副本" Click="ExportButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE2B4;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton x:Name="SearchButton" Width="40" IsCompact="True" AutomationProperties.Name="搜索 PDF 文字"
                        ToolTipService.ToolTip="搜索 (Ctrl+F)" Click="SearchButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE11A;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton x:Name="AnnotationToolsButton" Width="40" IsCompact="True"
                        AutomationProperties.Name="批注工具" ToolTipService.ToolTip="批注工具：文字选择、笔、荧光笔、橡皮擦"
                        Click="AnnotationToolsButton_Click"><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE104;" /></AppBarButton.Icon>

                    </AppBarButton>

                </StackPanel>
            </Grid>
        </Border>


        <Border x:Name="AnnotationToolbar" Grid.Row="1" Visibility="Collapsed" Background="#FAFAFB" BorderBrush="#DADADF" BorderThickness="0,0,0,1" Padding="8,4">
                                <StackPanel x:Name="InkControlsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center">

                                    <AppBarToggleButton
                                        x:Name="TopSelectButton" Width="40"
                                        IsCompact="True"
                                        AutomationProperties.Name="选择文字"
                                        ToolTipService.ToolTip="选择文字：拖动选中，右键复制或高亮"
                                        Click="TopSelectButton_Click">
                                        <AppBarToggleButton.Icon>
                                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE185;" />
                                        </AppBarToggleButton.Icon>
                                    </AppBarToggleButton>
                                    <AppBarToggleButton
                                        x:Name="TopTouchWritingButton" Width="40"
                                        IsCompact="True"
                                        AutomationProperties.Name="触摸书写"
                                        ToolTipService.ToolTip="触摸书写：关闭时手指滚动，开启时手指书写"
                                        Click="TopTouchWritingButton_Click">
                                        <AppBarToggleButton.Icon>
                                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE1E3;" />
                                        </AppBarToggleButton.Icon>
                                    </AppBarToggleButton>

                                    <AppBarToggleButton
                                        x:Name="TopPenButton" Width="40"
                                        IsCompact="True"
                                        AutomationProperties.Name="笔"
                                        ToolTipService.ToolTip="笔：点击书写，右侧箭头设置颜色与粗细"
                                        Click="TopPenButton_Click">
                                        <AppBarToggleButton.Icon>
                                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE104;" />
                                        </AppBarToggleButton.Icon>
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="PenFlyout" Placement="Bottom">
                                                <StackPanel Width="236" Margin="4">
                                                    <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                                    <Grid x:Name="PenColorGrid" />
                                                    <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                                    <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                                        <Canvas Height="36">
                                                            <Path
                                                                x:Name="PenPreviewStroke"
                                                                Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18"
                                                                Stroke="#E81123"
                                                                StrokeThickness="3"
                                                                StrokeStartLineCap="Round"
                                                                StrokeEndLineCap="Round"
                                                                StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Border>
                                                    <TextBlock x:Name="PenSizeText" FontSize="12" Foreground="#555555" Margin="0,0,0,4" />
                                    <Slider
                                                        x:Name="PenSizeSlider" AutomationProperties.Name="笔粗细"
                                                        Minimum="1"
                                                        Maximum="24"
                                                        Value="3"
                                                        StepFrequency="1"
                                                        IsThumbToolTipEnabled="False"
                                                        ValueChanged="PenSizeSlider_ValueChanged" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource CompactButtonStyle}" Content="1" Tag="1" Click="PenSizePreset_Click" AutomationProperties.Name="粗细 1" /><Button Style="{StaticResource CompactButtonStyle}" Content="3" Tag="3" Click="PenSizePreset_Click" AutomationProperties.Name="粗细 3" /><Button Style="{StaticResource CompactButtonStyle}" Content="6" Tag="6" Click="PenSizePreset_Click" AutomationProperties.Name="粗细 6" /></StackPanel></StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AppBarToggleButton>
                    <Button Style="{StaticResource CompactButtonStyle}" Width="36" Click="PenSettingsButton_Click" AutomationProperties.Name="笔设置" ToolTipService.ToolTip="颜色与粗细"><StackPanel><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE2A3;" FontSize="12" /><Rectangle x:Name="PenColorIndicator" Width="18" Height="3" Margin="0,5,0,0" /></StackPanel></Button>

                    <AppBarToggleButton
                        x:Name="TopHighlighterButton" Width="40"
                        IsCompact="True"
                        AutomationProperties.Name="荧光笔"
                        ToolTipService.ToolTip="荧光笔：点击书写，右侧箭头设置颜色与粗细"
                        Click="TopHighlighterButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE193;" />
                        </AppBarToggleButton.Icon>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="HighlighterFlyout" Placement="Bottom">
                                <StackPanel Width="236" Margin="4">
                                    <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                    <Grid x:Name="HighlighterColorGrid" />
                                    <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                    <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                        <Canvas Height="36">
                                            <Path
                                                x:Name="HighlighterPreviewStroke"
                                                Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18"
                                                Stroke="#FFF100"
                                                StrokeThickness="12"
                                                Opacity="0.6"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Border>
                                    <TextBlock x:Name="HighlighterSizeText" FontSize="12" Foreground="#555555" Margin="0,0,0,4" />
                                    <Slider
                                        x:Name="HighlighterSizeSlider" AutomationProperties.Name="荧光笔粗细"
                                        Minimum="4"
                                        Maximum="36"
                                        Value="12"
                                        StepFrequency="1"
                                        IsThumbToolTipEnabled="False"
                                        ValueChanged="HighlighterSizeSlider_ValueChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource CompactButtonStyle}" Content="8" Tag="8" Click="HighlighterSizePreset_Click" AutomationProperties.Name="粗细 8" /><Button Style="{StaticResource CompactButtonStyle}" Content="12" Tag="12" Click="HighlighterSizePreset_Click" AutomationProperties.Name="粗细 12" /><Button Style="{StaticResource CompactButtonStyle}" Content="20" Tag="20" Click="HighlighterSizePreset_Click" AutomationProperties.Name="粗细 20" /></StackPanel></StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AppBarToggleButton>
                    <Button Style="{StaticResource CompactButtonStyle}" Width="36" Click="HighlighterSettingsButton_Click" AutomationProperties.Name="荧光笔设置" ToolTipService.ToolTip="颜色与粗细"><StackPanel><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE2A3;" FontSize="12" /><Rectangle x:Name="HighlighterColorIndicator" Width="18" Height="3" Margin="0,5,0,0" /></StackPanel></Button>

                    <AppBarToggleButton
                        x:Name="TopEraserButton" Width="40"
                        IsCompact="True"
                        AutomationProperties.Name="橡皮擦"
                        ToolTipService.ToolTip="橡皮擦"
                        Click="TopEraserButton_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE294;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>

                    <AppBarSeparator Width="12" />

                    <AppBarButton
                        x:Name="TopUndoButton" Width="40"

                        IsCompact="True"
                        AutomationProperties.Name="撤销"
                        ToolTipService.ToolTip="撤销"
                        Click="UndoButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE10E;" /></AppBarButton.Icon></AppBarButton>

                    <AppBarButton
                        x:Name="TopClearButton" Width="40"

                        IsCompact="True"
                        AutomationProperties.Name="清除本页批注"
                        ToolTipService.ToolTip="清除本页批注"
                        Click="ClearButton_Click" ><AppBarButton.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE107;" /></AppBarButton.Icon></AppBarButton>
                </StackPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="2" SizeChanged="DocumentSurface_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ThumbColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ThumbnailPane"
                Grid.Column="1"
                Width="0"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Background="#F7F7F8"
                BorderBrush="#DFDFE3"
                BorderThickness="1,0,0,0">
                <Grid Width="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#86868B"
                        Text="页面" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource CompactButtonStyle}" Click="CloseThumbnails_Click" AutomationProperties.Name="关闭缩略图" ToolTipService.ToolTip="关闭缩略图"><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE10A;" FontSize="12" /></Button>
                    <ScrollViewer x:Name="ThumbnailScroller"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        ViewChanged="ThumbnailScroller_ViewChanged" SizeChanged="ThumbnailScroller_SizeChanged">
                        <Canvas x:Name="ThumbnailPanel" Width="94" Margin="6,10,6,20" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="DocumentScroller"
                Grid.Column="0"
                Margin="13,7,13,7"
                AutomationProperties.Name="Document scroller"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Enabled"
                MinZoomFactor="0.25"
                MaxZoomFactor="4"
                Background="#EFEFF1"
                SizeChanged="DocumentScroller_SizeChanged"
                ViewChanged="DocumentScroller_ViewChanged"
                LayoutUpdated="DocumentScroller_LayoutUpdated">
                <Grid x:Name="PageFrame" HorizontalAlignment="Center">
                    <Canvas x:Name="PageStack" HorizontalAlignment="Center" />
                </Grid>
            </ScrollViewer>

            <!-- ===================== Floating HUD toolbar (Quick Look style) ===================== -->
            <!-- Reserve the toolbar's reveal area so hovering after idle never inks the page. -->
            <Border x:Name="HudRevealZone" Grid.ColumnSpan="2" Width="320" Height="64"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                Background="Transparent" Visibility="Collapsed" />
            <Border
                x:Name="HudBar"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                RequestedTheme="Dark"
                Visibility="Collapsed">
                <Grid>
                    <Rectangle
                        RadiusX="10"
                        RadiusY="10"
                        Fill="#F22B2B30"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1" />
                    <StackPanel Orientation="Horizontal" Margin="8,6" VerticalAlignment="Center">

                        <!-- page navigation -->
                        <Button
                            x:Name="PreviousButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="上一页"
                            ToolTipService.ToolTip="上一页"
                            Click="PreviousButton_Click">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE239;" FontSize="16" />
                        </Button>
                        <TextBlock
                            x:Name="PageStatusText"
                            MinWidth="52"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Text="0 / 0"
                            TextAlignment="Center" />
                        <Button
                            x:Name="NextButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="下一页"
                            ToolTipService.ToolTip="下一页"
                            Click="NextButton_Click">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE23A;" FontSize="16" />
                        </Button>

                        <Rectangle Width="1" Height="18" RadiusX="0.5" RadiusY="0.5" Margin="7,0" Fill="#24FFFFFF" />

                        <!-- zoom controls -->
                        <Button
                            x:Name="ZoomOutButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="缩小"
                            ToolTipService.ToolTip="缩小 (-)"
                            Click="ZoomOutButton_Click">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE108;" FontSize="16" />
                        </Button>

                        <Button
                            x:Name="ZoomPercentButton"
                            Style="{StaticResource HudTextButtonStyle}"
                            AutomationProperties.Name="缩放比例"
                            ToolTipService.ToolTip="点击输入精确缩放比例"
                            Click="ZoomPercentButton_Click">
                            <TextBlock
                                x:Name="ZoomLabel"
                                MinWidth="38"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#F2FFFFFF"
                                Text="100%"
                                TextAlignment="Center" />
                            <Button.Flyout>
                                <Flyout x:Name="ZoomInputFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal" Padding="4">
                                        <TextBox
                                            x:Name="ZoomInputBox"
                                            Width="56"
                                            Height="32"
                                            FontSize="13"
                                            TextAlignment="Right"
                                            VerticalContentAlignment="Center"
                                            KeyDown="ZoomInputBox_KeyDown" />
                                        <TextBlock
                                            Text="%"
                                            VerticalAlignment="Center"
                                            Margin="4,0,8,0"
                                            FontSize="13"
                                            Foreground="#333333" />
                                        <Button
                                            x:Name="ZoomInputOkButton"
                                            Content="确定"
                                            Height="32"
                                            MinWidth="46"
                                            Click="ZoomInputOkButton_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="ZoomInButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="放大"
                            ToolTipService.ToolTip="放大 (+)"
                            Click="ZoomInButton_Click">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE109;" FontSize="16" />
                        </Button>

                        <!-- Zoom Slider (Native UWP Slider) -->
                        <Slider
                            x:Name="ZoomSlider"
                            Width="84"
                            Margin="4,0"
                            Minimum="25"
                            Maximum="400"
                            Value="100"
                            StepFrequency="1"
                            IsThumbToolTipEnabled="False"
                            AutomationProperties.Name="缩放滑块"
                            ToolTipService.ToolTip="缩放滑块"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />

                        <Button
                            x:Name="FitButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="适应页面"
                            ToolTipService.ToolTip="适应页面 (0)"
                            Click="FitButton_Click">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE1D8;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Empty state ===================== -->
            <StackPanel
                x:Name="EmptyState"
                Grid.ColumnSpan="2"
                Width="340"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE160;" FontSize="48" Foreground="#A8AFB8" HorizontalAlignment="Center" />
                <TextBlock
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="#1D1D1F"
                    Text="uwPDF" />
                <TextBlock
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="#86868B"
                    Text="打开 PDF，开始阅读与批注。" />
                <Button
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="打开 PDF…"
                    Click="OpenButton_Click" />
            </StackPanel>
            <Border x:Name="SearchPanel" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="12" Padding="12" Background="#FAFAFC" BorderBrush="#D0D0D4" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SearchTextBox" Width="220" AutomationProperties.Name="查找 PDF 文字" PlaceholderText="查找文字" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" />
                        <Button Style="{StaticResource CompactButtonStyle}" Click="FindPrevious_Click" AutomationProperties.Name="上一个匹配" ><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE110;" FontSize="14" /></Button>
                        <Button Style="{StaticResource CompactButtonStyle}" Click="FindNext_Click" AutomationProperties.Name="下一个匹配" ><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE118;" FontSize="14" /></Button>
                        <Button Style="{StaticResource CompactButtonStyle}" Click="CloseSearch_Click" AutomationProperties.Name="关闭搜索" ><FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE10A;" FontSize="14" /></Button>
                    </StackPanel>
                    <TextBlock x:Name="SearchStatus" Margin="2,4,0,0" FontSize="12" Foreground="#62626A" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
