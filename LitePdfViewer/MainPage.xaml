<Page
    x:Class="LitePdfViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <Style TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>


        <!-- Keep the native Button/ToggleButton templates and system focus visuals. -->
        <Style x:Key="ReaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#32363C" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <Style x:Key="ReaderToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#32363C" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E7EFF7" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DAE8F5" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#CADDEE" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#254A6E" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#254A6E" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#254A6E" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#A7C5E2" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#A7C5E2" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#8AB3DA" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />

        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>


        <!-- A fixed 32-DIP touch surface; only the 3/8-DIP visual expands.
             Native parts handle mouse input, captured touch drags use the owner. -->
        <ControlTemplate x:Key="ThinScrollThumb" TargetType="primitives:Thumb">
            <Grid Background="Transparent" Width="32">
                <Border Margin="0,0,2,0" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="1.5" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ScrollTrackButton" TargetType="primitives:RepeatButton">
            <Grid Background="Transparent" ManipulationMode="None" />
        </ControlTemplate>
        <Style TargetType="primitives:ScrollBar">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="32" ManipulationMode="None" Loaded="ScrollBarRoot_Loaded">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="VerticalThumb.BorderThickness" Value="0,0,8,0" />
                                            <Setter Target="Root.Background" Value="#08000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                    <VisualState x:Name="NoIndicator" />
                                    <VisualState x:Name="TouchIndicator" />
                                    <VisualState x:Name="MouseIndicator" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="TouchDragStates">
                                    <VisualState x:Name="TouchIdle" />
                                    <VisualState x:Name="TouchDragging">
                                        <VisualState.Setters>
                                            <Setter Target="VerticalThumb.BorderThickness" Value="0,0,8,0" />
                                            <Setter Target="Root.Background" Value="#08000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="VerticalRoot">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <primitives:RepeatButton x:Name="VerticalSmallDecrease" Height="0" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" IsTabStop="False" ManipulationMode="None"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2" Width="32" MinHeight="44" BorderThickness="0,0,3,0" ManipulationMode="None"
                                    Template="{StaticResource ThinScrollThumb}" AutomationProperties.AccessibilityView="Raw" />
                                <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" IsTabStop="False" ManipulationMode="None"
                                    Template="{StaticResource ScrollTrackButton}" />
                                <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" IsTabStop="False"
                                    Template="{StaticResource ScrollTrackButton}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HUD icon button (dark floating toolbar) -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="CheckedRect" RadiusY="7" Fill="#30FFFFFF" Opacity="0" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#3DFFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HUD text button style (for clickable zoom percentage) -->
        <Style x:Key="HudTextButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" RadiusX="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" RadiusX="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Color swatch in the HUD -->
        <Style x:Key="HudSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle
                                RadiusY="6"
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="1" />
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#1FFFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#33FFFFFF" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Thumbnail card button -->
        <Style x:Key="ThumbCardStyle" TargetType="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="HoverRect" RadiusY="6" Fill="#0D000000" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="6" Fill="#14000000" Opacity="0" />
                            <ContentPresenter
                                x:Name="Content"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent action button (empty state) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#0A7AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="BaseRect" RadiusY="7" Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HoverRect" RadiusY="7" Fill="#FFFFFF" Opacity="0" />
                            <Rectangle x:Name="PressedRect" RadiusY="7" Fill="#000000" Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRect" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedRect" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BaseRect" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainChrome" Background="#EFEFF1">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One compact row at desktop widths; ink tools wrap as a group below 800 DIP. -->
        <ContentControl x:Name="MainCommandBar" Grid.RowSpan="2" IsTabStop="False"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid x:Name="ReaderToolbar" Background="#F8F8F9" SizeChanged="ReaderToolbar_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ToolbarBalanceColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button x:Name="OpenButton" Style="{StaticResource ReaderButtonStyle}"
                        AutomationProperties.Name="打开 PDF" ToolTipService.ToolTip="打开 PDF (Ctrl+O)" Click="OpenButton_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED25;" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource ReaderButtonStyle}"
                        AutomationProperties.Name="保存批注" ToolTipService.ToolTip="保存批注 (Ctrl+S)" Click="SaveButton_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" />
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="#DADDE1" Margin="5,0" />
                    <primitives:ToggleButton x:Name="ThumbsToggle" Style="{StaticResource ReaderToggleStyle}" IsChecked="False"
                        AutomationProperties.Name="页面缩略图" ToolTipService.ToolTip="页面缩略图" Click="ThumbsToggle_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90D;" />
                    </primitives:ToggleButton>
                </StackPanel>
                <Grid x:Name="FileTitleRegion" Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" HorizontalAlignment="Stretch" TextAlignment="Left"
                        FontSize="13" Foreground="#32363C" Text="uwPDF" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border x:Name="AnnotationToolbar" Grid.Column="2" Height="44" Margin="8,0"
                    Visibility="Collapsed" HorizontalAlignment="Center">
                    <StackPanel x:Name="InkControlsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <primitives:ToggleButton x:Name="TopSelectButton" Style="{StaticResource ReaderToggleStyle}"
                            AutomationProperties.Name="选择文字" ToolTipService.ToolTip="选择文字" Click="TopSelectButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D2;" />
                        </primitives:ToggleButton>
                        <StackPanel Orientation="Horizontal" Margin="4,0,2,0">
                            <primitives:ToggleButton x:Name="TopPenButton" Style="{StaticResource ReaderToggleStyle}"
                                AutomationProperties.Name="笔" ToolTipService.ToolTip="笔；再次点击设置颜色与粗细" Click="TopPenButton_Click">
                                <Grid Width="20" Height="27">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76D;" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Rectangle x:Name="PenColorIndicator" Width="16" Height="3" VerticalAlignment="Bottom" />
                                </Grid>
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="PenFlyout" Placement="Bottom">
                                        <StackPanel Width="220" Margin="0">
                                            <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                            <Grid x:Name="PenColorGrid" />
                                            <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                            <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                                <Canvas Height="36">
                                                    <Path x:Name="PenPreviewStroke" Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18" Stroke="#E81123" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Border>
                                            <TextBlock x:Name="PenSizeText" FontSize="12" Foreground="#555555" Margin="0,0,0,4" />
                                            <Slider x:Name="PenSizeSlider" AutomationProperties.Name="笔粗细" Minimum="1" Maximum="24" Value="3" StepFrequency="1" IsThumbToolTipEnabled="False" ValueChanged="PenSizeSlider_ValueChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </primitives:ToggleButton>
                            <Button x:Name="PenSettingsButton" Style="{StaticResource ReaderButtonStyle}" Width="18" MinWidth="18"
                                Click="PenSettingsButton_Click" AutomationProperties.Name="笔设置" ToolTipService.ToolTip="笔颜色与粗细">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <primitives:ToggleButton x:Name="TopHighlighterButton" Style="{StaticResource ReaderToggleStyle}"
                                AutomationProperties.Name="荧光笔" ToolTipService.ToolTip="荧光笔；再次点击设置颜色与粗细" Click="TopHighlighterButton_Click">
                                <Grid Width="20" Height="27">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E6;" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Rectangle x:Name="HighlighterColorIndicator" Width="16" Height="3" VerticalAlignment="Bottom" />
                                </Grid>
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="HighlighterFlyout" Placement="Bottom">
                                        <StackPanel Width="220" Margin="0">
                                            <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                            <Grid x:Name="HighlighterColorGrid" />
                                            <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,12,0,6" />
                                            <Border Background="#F7F7F8" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="4" Height="36" Margin="0,0,0,8">
                                                <Canvas Height="36">
                                                    <Path x:Name="HighlighterPreviewStroke" Data="M 12,18 C 45,6 75,30 118,18 C 150,8 180,28 214,18" Stroke="#FFF100" StrokeThickness="12" Opacity="0.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Border>
                                            <TextBlock x:Name="HighlighterSizeText" FontSize="12" Foreground="#555555" Margin="0,0,0,4" />
                                            <Slider x:Name="HighlighterSizeSlider" AutomationProperties.Name="荧光笔粗细" Minimum="4" Maximum="36" Value="12" StepFrequency="1" IsThumbToolTipEnabled="False" ValueChanged="HighlighterSizeSlider_ValueChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </primitives:ToggleButton>
                            <Button x:Name="HighlighterSettingsButton" Style="{StaticResource ReaderButtonStyle}" Width="18" MinWidth="18"
                                Click="HighlighterSettingsButton_Click" AutomationProperties.Name="荧光笔设置" ToolTipService.ToolTip="荧光笔颜色与粗细">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10" />
                            </Button>
                        </StackPanel>
                        <primitives:ToggleButton x:Name="TopEraserButton" Style="{StaticResource ReaderToggleStyle}"
                            AutomationProperties.Name="橡皮擦" ToolTipService.ToolTip="橡皮擦" Click="TopEraserButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE75C;" />
                        </primitives:ToggleButton>
                        <Rectangle Width="1" Height="18" Fill="#DADDE1" Margin="8,0" />
                        <Button x:Name="TopUndoButton" Style="{StaticResource ReaderButtonStyle}"
                            AutomationProperties.Name="撤销" ToolTipService.ToolTip="撤销 (Ctrl+Z)" Click="UndoButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7A7;" />
                        </Button>
                        <Button x:Name="InkMoreButton" Style="{StaticResource ReaderButtonStyle}"
                            AutomationProperties.Name="更多批注选项" ToolTipService.ToolTip="更多批注选项">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MinWidth="170">
                                        <CheckBox x:Name="TopTouchWritingButton" Content="触摸书写"
                                            AutomationProperties.Name="触摸书写" Click="TopTouchWritingButton_Click" />
                                        <TextBlock Text="关闭时手指用于滚动" FontSize="12" Foreground="#6C7078" Margin="0,0,0,8" />
                                        <Rectangle Height="1" Fill="#E0E2E5" Margin="0,0,0,8" />
                                        <Button x:Name="TopClearButton" Background="Transparent" BorderThickness="0" Padding="4,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ClearButton_Click"
                                            AutomationProperties.Name="清除本页批注">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14" Margin="0,0,10,0" />
                                                <TextBlock Text="清除本页批注" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="SearchButton" Style="{StaticResource ReaderButtonStyle}"
                        AutomationProperties.Name="搜索 PDF 文字" ToolTipService.ToolTip="搜索 (Ctrl+F)" Click="SearchButton_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" />
                    </Button>
                    <Button x:Name="ShareButton" Style="{StaticResource ReaderButtonStyle}"
                        AutomationProperties.Name="分享 PDF" ToolTipService.ToolTip="分享 PDF（自动保存批注）" Click="ShareButton_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" />
                    </Button>
                    <primitives:ToggleButton x:Name="AnnotationToolsButton" Style="{StaticResource ReaderToggleStyle}"
                        AutomationProperties.Name="批注工具" ToolTipService.ToolTip="展开批注工具" Click="AnnotationToolsButton_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" />
                    </primitives:ToggleButton>
                </StackPanel>
                <Border Height="1" Background="#DADDE1" VerticalAlignment="Bottom" Grid.RowSpan="2" Grid.ColumnSpan="5" />
            </Grid>
        </ContentControl>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="2" SizeChanged="DocumentSurface_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ThumbColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ThumbnailPane"
                Grid.Column="1"
                Width="0"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Background="#F7F7F8"
                BorderBrush="#DFDFE3"
                BorderThickness="1,0,0,0">
                <Grid Width="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#86868B"
                        Text="页面" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource CompactButtonStyle}" Click="CloseThumbnails_Click" AutomationProperties.Name="关闭缩略图" ToolTipService.ToolTip="关闭缩略图"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" /></Button>
                    <ScrollViewer x:Name="ThumbnailScroller"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        ViewChanged="ThumbnailScroller_ViewChanged" SizeChanged="ThumbnailScroller_SizeChanged">
                        <Canvas x:Name="ThumbnailPanel" Width="94" Margin="6,10,6,20" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="DocumentScroller"
                Grid.Column="0"
                Margin="13,7,13,7"
                AutomationProperties.Name="Document scroller"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Center"
                ZoomMode="Enabled"
                MinZoomFactor="0.25"
                MaxZoomFactor="4"
                Background="#EFEFF1"
                SizeChanged="DocumentScroller_SizeChanged"
                ViewChanged="DocumentScroller_ViewChanged"
                LayoutUpdated="DocumentScroller_LayoutUpdated">
                <Grid x:Name="PageFrame" HorizontalAlignment="Center">
                    <Canvas x:Name="PageStack" HorizontalAlignment="Center" />
                </Grid>
            </ScrollViewer>

            <!-- Search presentation only: no hit testing and no PDF/ink changes. -->
            <Canvas x:Name="SearchFocusLayer" Grid.Column="0" Margin="13,7,13,7"
                Visibility="Collapsed" IsHitTestVisible="False">
                <Path x:Name="SearchDimPath" Fill="#58000000" />
                <Path x:Name="SearchMatchPath" Fill="#66FFD84D" Stroke="#E5AD16" StrokeThickness="1" />
            </Canvas>

            <!-- ===================== Floating HUD toolbar (Quick Look style) ===================== -->
            <!-- Reserve the toolbar's reveal area so hovering after idle never inks the page. -->
            <Border x:Name="HudRevealZone" Grid.ColumnSpan="2" Width="320" Height="56"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                Background="Transparent" Visibility="Collapsed" />
            <Border
                x:Name="HudBar"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                RequestedTheme="Dark"
                Visibility="Collapsed">
                <Grid>
                    <Rectangle
                        RadiusX="10"
                        RadiusY="10"
                        Fill="#F22B2B30"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1" />
                    <StackPanel Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center">

                        <!-- page navigation -->
                        <Button
                            x:Name="PreviousButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="上一页"
                            ToolTipService.ToolTip="上一页"
                            Click="PreviousButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" FontSize="16" />
                        </Button>
                        <TextBlock
                            x:Name="PageStatusText"
                            MinWidth="52"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Text="0 / 0"
                            TextAlignment="Center" />
                        <Button
                            x:Name="NextButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="下一页"
                            ToolTipService.ToolTip="下一页"
                            Click="NextButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" />
                        </Button>

                        <Rectangle Width="1" Height="18" RadiusX="0.5" RadiusY="0.5" Margin="7,0" Fill="#24FFFFFF" />

                        <!-- zoom controls -->
                        <Button
                            x:Name="ZoomOutButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="缩小"
                            ToolTipService.ToolTip="缩小 (-)"
                            Click="ZoomOutButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE738;" FontSize="16" />
                        </Button>

                        <Button
                            x:Name="ZoomPercentButton"
                            Style="{StaticResource HudTextButtonStyle}"
                            AutomationProperties.Name="缩放比例"
                            ToolTipService.ToolTip="点击输入精确缩放比例"
                            Click="ZoomPercentButton_Click">
                            <TextBlock
                                x:Name="ZoomLabel"
                                MinWidth="38"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#F2FFFFFF"
                                Text="100%"
                                TextAlignment="Center" />
                            <Button.Flyout>
                                <Flyout x:Name="ZoomInputFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal" Padding="4">
                                        <TextBox
                                            x:Name="ZoomInputBox"
                                            Width="56"
                                            Height="32"
                                            FontSize="13"
                                            TextAlignment="Right"
                                            VerticalContentAlignment="Center"
                                            KeyDown="ZoomInputBox_KeyDown" />
                                        <TextBlock
                                            Text="%"
                                            VerticalAlignment="Center"
                                            Margin="4,0,8,0"
                                            FontSize="13"
                                            Foreground="#333333" />
                                        <Button
                                            x:Name="ZoomInputOkButton"
                                            Content="确定"
                                            Height="32"
                                            MinWidth="46"
                                            Click="ZoomInputOkButton_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="ZoomInButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="放大"
                            ToolTipService.ToolTip="放大 (+)"
                            Click="ZoomInButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="16" />
                        </Button>

                        <!-- Zoom Slider (Native UWP Slider) -->
                        <Slider
                            x:Name="ZoomSlider"
                            Width="84"
                            Margin="4,0"
                            Minimum="25"
                            Maximum="400"
                            Value="100"
                            StepFrequency="1"
                            IsThumbToolTipEnabled="False"
                            AutomationProperties.Name="缩放滑块"
                            ToolTipService.ToolTip="缩放滑块"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />

                        <Button
                            x:Name="FitButton"
                            Style="{StaticResource HudButtonStyle}"
                            AutomationProperties.Name="适应页面"
                            ToolTipService.ToolTip="适应页面 (0)"
                            Click="FitButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9A6;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Empty state ===================== -->
            <StackPanel
                x:Name="EmptyState"
                Grid.ColumnSpan="2"
                Width="340"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C3;" FontSize="48" Foreground="#A8AFB8" HorizontalAlignment="Center" />
                <TextBlock
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="#1D1D1F"
                    Text="uwPDF" />
                <TextBlock
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="#86868B"
                    Text="打开 PDF，开始阅读与批注。" />
                <Button
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="打开 PDF…"
                    Click="OpenButton_Click" />
            </StackPanel>
            <Border x:Name="SearchPanel" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="12" Padding="12" Background="#FAFAFC" BorderBrush="#D0D0D4" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SearchTextBox" Width="220" AutomationProperties.Name="查找 PDF 文字" PlaceholderText="查找文字" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" />
                        <Button x:Name="FindPreviousButton" Style="{StaticResource CompactButtonStyle}" Click="FindPrevious_Click" AutomationProperties.Name="上一个匹配" ToolTipService.ToolTip="上一个 (Shift+Enter)"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74A;" FontSize="14" /></Button>
                        <Button x:Name="FindNextButton" Style="{StaticResource CompactButtonStyle}" Click="FindNext_Click" AutomationProperties.Name="下一个匹配" ToolTipService.ToolTip="下一个 (Enter)"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74B;" FontSize="14" /></Button>
                        <Button Style="{StaticResource CompactButtonStyle}" Click="CloseSearch_Click" AutomationProperties.Name="关闭搜索" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14" /></Button>
                    </StackPanel>
                    <TextBlock x:Name="SearchStatus" Margin="2,4,0,0" FontSize="12" Foreground="#62626A" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
